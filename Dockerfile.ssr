FROM oven/bun:alpine@sha256:4cf82f5686b196504fe119db3fcd9185b191f82ece82c40680e597228ec6070a AS web
WORKDIR /app
COPY package.json bun.lock ./
COPY packages ./packages
COPY patches ./patches
RUN bun install
COPY . .
RUN apk add --no-cache git && git init -q . && git -c user.name=x -c user.email=x@x commit -q --allow-empty -m build && git tag build
RUN bun run build && bun run build:ssr

FROM voidic/nostr-ssr:latest
COPY --from=web /app/build /app/dist/client
COPY --from=web /app/build/ssr /app/dist/ssr
RUN rm -rf /app/dist/client/ssr
COPY ssr.json /app/ssr.json
ENV CONFIG=/app/ssr.json
